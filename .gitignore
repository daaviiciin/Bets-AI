# =========================================================
#  Variables de entorno y secretos
# =========================================================
.env
.env.*
!.env.example
*.key
*.pem

# =========================================================
#  Datos crudos y procesados (no subir a git)
# =========================================================
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3

# =========================================================
#  Python
# =========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/

# =========================================================
#  Node / Angular (cuando llegue la fase del front)
# =========================================================
node_modules/
dist/
.angular/
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================================
#  IDEs y editores
# =========================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =========================================================
#  Sistema operativo
# =========================================================
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
#  Docker
# =========================================================
postgres_data/

# Copias de seguridad de la BD (contienen usuarios)
backups/

# Grafo de graphify (se regenera con `graphify update .`)
graphify-out/
