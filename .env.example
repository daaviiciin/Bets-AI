# =========================================================
#  Bets AI - Variables de entorno
#  Copia este fichero a .env y rellena los valores reales.
# =========================================================

# ---------------------------------------------------------
#  The Odds API (https://the-odds-api.com)
# ---------------------------------------------------------
ODDS_API_KEY=tu_api_key_aqui
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# ---------------------------------------------------------
#  PostgreSQL (Docker)
# ---------------------------------------------------------
POSTGRES_USER=betsai
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=betsai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cadena de conexión que usará SQLAlchemy
DATABASE_URL=postgresql+psycopg2://betsai:cambia_esta_password@localhost:5432/betsai

# ---------------------------------------------------------
#  LLM para explicaciones (Fase 7)
# ---------------------------------------------------------
# Opciones: gemini, groq, openai, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------
#  Configuración general
# ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
