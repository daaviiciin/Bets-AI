# =========================================================
#  Bets AI - Variables de entorno
#  Copia este fichero a .env y rellena los valores reales.
# =========================================================

# Pipeline “oficial”: stats Flashscore + cuotas Winamax; EV con modelo + devig.
OFFICIAL_DATA_PIPELINE=false
PRIMARY_BOOKMAKER_KEY=winamax_es

# Winamax: cuántos snapshots por liga conservar tras cada lectura de cuotas (los viejos se borran con sus odds).
WINAMAX_SNAPSHOT_RETENTION=2

# Value bets (fútbol): mezcla temporada + últimos partidos casa/fuera; suelo de P para 1X2
VALUE_BETS_USE_RECENT_GOAL_FORM=true
VALUE_BETS_RECENT_FORM_MATCHES=8
VALUE_BETS_RECENT_FORM_WEIGHT=0.38
VALUE_BETS_H2H_MIN_MODEL_PROBABILITY=0.22

# ---------------------------------------------------------
#  PostgreSQL (Docker)
# ---------------------------------------------------------
POSTGRES_USER=betsai
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=betsai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cadena de conexión que usará SQLAlchemy
DATABASE_URL=postgresql+psycopg2://betsai:cambia_esta_password@localhost:5432/betsai

# ---------------------------------------------------------
#  Configuración general
# ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------
#  Seguridad de la API
# ---------------------------------------------------------
# Secreto de los JWT de sesión (obligatorio: sin él la API no arranca). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Duración de la sesión en días (máx. 30)
JWT_ACCESS_TTL_DAYS=7
# Orígenes CORS permitidos, separados por comas (el frontend usa el proxy de Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Límites de peticiones (sintaxis de la librería `limits`)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REFRESH=1 per 3 minutes
RATE_LIMIT_GENERAL=120/minute
# Tamaño máximo del cuerpo de una petición, en bytes
MAX_REQUEST_BODY_BYTES=1048576
