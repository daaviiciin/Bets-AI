# =========================================================
#  Bets AI - Variables de entorno
#  Copia este fichero a .env y rellena los valores reales.
# =========================================================

# ---------------------------------------------------------
#  The Odds API (https://the-odds-api.com)
# ---------------------------------------------------------
# Por defecto OFF: POST /refresh no gasta créditos. Activa solo si quieres Capa 1 Odds API.
# Vacío u ODDS_API_REFRESH_ENABLED=false ⇒ no se llama Odds API (el dashboard usa /refresh/official).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REFRESH_ENABLED=false

# Pipeline “oficial”: stats Flashscore + cuotas Winamax; EV con modelo + devig.
OFFICIAL_DATA_PIPELINE=false
PRIMARY_BOOKMAKER_KEY=winamax_es

# Winamax: cuántos snapshots por liga conservar tras cada /refresh/official (los viejos se borran con sus odds).
WINAMAX_SNAPSHOT_RETENTION=2

# Value bets (fútbol): mezcla temporada + últimos partidos casa/fuera; suelo de P para 1X2
VALUE_BETS_USE_RECENT_GOAL_FORM=true
VALUE_BETS_RECENT_FORM_MATCHES=8
VALUE_BETS_RECENT_FORM_WEIGHT=0.38
VALUE_BETS_H2H_MIN_MODEL_PROBABILITY=0.22

# ---------------------------------------------------------
#  PostgreSQL (Docker)
# ---------------------------------------------------------
POSTGRES_USER=betsai
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=betsai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cadena de conexión que usará SQLAlchemy
DATABASE_URL=postgresql+psycopg2://betsai:cambia_esta_password@localhost:5432/betsai

# ---------------------------------------------------------
#  LLM para explicaciones (Fase 7)
# ---------------------------------------------------------
# Opciones: gemini, groq, openai, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------
#  Configuración general
# ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
